# Copy to .env and replace the value, or generate one with:
#   node -e "require('fs').writeFileSync('.env', 'JWT_SECRET=' + require('crypto').randomBytes(32).toString('hex') + '\n')"
#
# Never commit the real .env file.

# Secret used by auth-service to sign JWTs. Use a long random value.
JWT_SECRET=replace-with-a-long-random-string
